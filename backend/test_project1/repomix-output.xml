    },
    username: {
        color: '#fff',
        fontSize: 16,
        fontWeight: '600',
    },
    timestamp: {
        color: '#aaa',
        fontSize: 12,
        marginTop: 2,
    },
    coverContainer: {
        alignItems: 'center',
        justifyContent: 'center',
        width: '100%',
        padding: 12,
    },
    cover: {
        width: SCREEN_WIDTH * 0.9,
        height: SCREEN_WIDTH * 0.9,
        maxWidth: 400,
        maxHeight: 400,
        borderRadius: 8,
    },
    contentContainer: {
        padding: 12,
    },
    albumTitle: {
        color: '#fff',
